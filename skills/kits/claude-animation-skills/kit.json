{
  "format": 1,
  "id": "claude-animation-skills",
  "version": "1.0.0",
  "description": "The shared kit of claude-animation-skills: fonts, helper scripts and the setup the skills' engines run with. The skills find it at ../../kit from their own folder, so a machine that runs them lays it out as <root>/kit next to <root>/skills/<id>.",
  "source": {
    "repo": "https://github.com/artemnovitckii/claude-animation-skills",
    "commit": "86f70106c9aeae1334184467da5776c533ada3bc",
    "path": "kit",
    "licence": "MIT",
    "copyright": "Copyright (c) 2026 Artem Novitckii"
  },
  "requires": [
    "ffmpeg",
    "node",
    "npm",
    "python3"
  ],
  "setup": {
    "notes": "files/setup.sh installs what is not in this folder: three.js and Playwright from files/package-lock.json, Playwright's Chromium, GSAP from cdnjs, HyperFrames 0.8.34 through npx, and with --voice a Python venv (numpy, scipy, soundfile, kokoro-onnx, sherpa-onnx) plus about 1 GB of models (Kokoro v1.0 and the Parakeet TDT 0.6b v2 int8 word aligner). Upstream pins none of these by hash, so delivering the kit to a worker needs them as a pinned environment recipe (skills/README.md, Delivery).",
    "downloads": [
      "npm ci from files/package-lock.json (three, playwright)",
      "Playwright's Chromium (npx playwright install chromium)",
      "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js",
      "npx hyperframes@0.8.34",
      "pip (unpinned): numpy scipy soundfile kokoro-onnx sherpa-onnx",
      "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx",
      "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin",
      "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8.tar.bz2"
    ]
  },
