{
  "format": 1,
  "id": "documentary-stills",
  "name": "Narrated documentary with stills",
  "description": "Narration over stills with slow camera moves and a clear timeline.",
  "version": "1.0.1",
  "status": "trial",
  "family": "documentary",
  "formats": {
    "supported": [
      "short",
      "long"
    ],
    "naturalFrame": "both"
  },
  "renderer": {
    "engine": "ffmpeg-stills",
    "minWorkerVersion": "0.9.0",
    "composition": null
  },
  "contract": {
    "pacing": {
      "shotSeconds": [
        4,
        8
      ],
      "hookWithinMs": 3000,
      "cutsPerMinute": [
        7,
        15
      ],
      "transitionSec": 0.5
    },
    "onScreen": {
      "elements": [
        "plate"
      ],
      "motionTokens": [
        "drift"
      ],
      "elementAnimation": false
    },
    "captions": {
      "required": true,
      "spec": "caption-spec-v1",
      "safeAreaPct": 8
    },
    "audio": {
      "narrated": true,
      "targetLufs": -14,
      "maxTruePeakDb": -1,
      "musicPolicy": "self-or-licensed"
    },
    "assets": {
      "model": "image-per-shot",
      "kinds": [
        "image"
      ],
      "allowedSources": [
        "upload",
        "hermes",
        "muse",
        "worker",
        "licensed",
        "generated"
      ],
      "forbidKinds": [
        "reference-video"
      ]
    }
  },
  "portal": {
    "beatShape": "ending-cta",
    "qc": {
      "minPresentationScore": 75,
      "gates": [
        "G-technical",
        "G-presentation",
        "G-assets",
        "G-compliance",
        "G-claims"
      ]
    },
    "themes": [
      "history",
      "science",
      "travel",
      "space",
      "finance"
    ],
    "keywords": [
      "documentary",
      "history",
      "historical",
      "story of",
      "the rise",
      "the fall",
      "biography",
      "narrated",
      "narration"
    ],
    "cautions": [
      "Use your own generated or licensed images and record each licence.",
      "Facts need primary sources in the description."
    ],
    "sources": [
      "https://www.seedance.tv/blog/faceless-youtube-channel-ideas"
    ]
  },
  "fixture": {
    "payload": "fixtures/payload.json",
    "expect": "fixtures/expect.json"
  },
  "provenance": [
    {
      "type": "article",
      "ref": "venturazz/venstudio docs/research/03-production-styles-and-muse-capabilities.md",
      "licence": "VenStudio research notes (owner)",
      "notes": "Where the style was first described: niche, engine, Muse placement and cautions."
    },
    {
      "type": "article",
      "ref": "venturazz/venstudio docs/research/04-autonomous-studio-workflow.md",
      "licence": "VenStudio research notes (owner)",
      "notes": "Template lifecycle, QC gates and the copyright checklist this pack's portal parameters come from."
    },
    {
      "type": "link",
      "ref": "https://www.seedance.tv/blog/faceless-youtube-channel-ideas",
      "licence": "public web page; read for patterns only, nothing copied",
      "notes": "Cited in the catalog as research for this niche."
    },
    {
      "type": "skill",
      "ref": "Hermes skill narrated-video-from-images (described in venturazz/venstudio docs/plans/2026-11-20-render-templates-from-skills.md)",
      "licence": "not recorded in the studio; the skill lives in the owner's Hermes install, only its parameters are used",
      "notes": "Stills with camera moves and xfade transitions between shots."
    }
  ],
  "curation": [
    {
      "date": "2026-11-21",
      "kind": "ci-render",
      "ref": "venturazz/venstudio CI, PR #15 (f712dcf): scripts/e2e.sh render-video with generated stills, then qc-video",
      "result": "pass",
      "notes": "The stills engine this pack's parameters drive. The pack's own fixture is rendered by the styles repo CI."
    }
  ],
  "workflow": {
    "recipe": "image-sequence"
  }
}
