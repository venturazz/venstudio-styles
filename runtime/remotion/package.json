    "probe": "node scripts/probe.mjs",
    "probe:full": "node scripts/probe.mjs --full"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.9.2"
  }
}
