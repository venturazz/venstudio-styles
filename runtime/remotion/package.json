{
  "name": "@venstudio/render-remotion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Remotion templates the VenStudio worker renders the remotion-2d engine with. Installed on the worker, not in the portal.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
