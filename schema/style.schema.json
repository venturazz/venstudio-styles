{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/venturazz/venstudio-styles/schema/style.schema.json",
  "title": "VenStudio style pack manifest (style.json), format 1",
  "description": "Documents the shape. tools/validate.mjs is what decides; it also checks cross-field rules (status needs curation evidence, id equals the directory, the render project matches the engine).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "description",
    "version",
    "status",
    "family",
    "formats",
    "renderer",
    "contract",
    "portal",
    "fixture",
    "provenance",
    "curation"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Equals the pack directory name."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})$"
    },
    "status": {
      "enum": [
        "draft",
        "lab",
        "trial",
        "proven",
        "listed",
        "retired"
      ]
    },
    "family": {
      "enum": [
        "explainer",
        "documentary",
        "narrative",
        "animation-2d",
        "animation-2.5d",
        "animation-3d",
        "motion-graphics",
        "game-style",
        "data-list",
        "ambient"
      ]
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "naturalFrame"
      ],
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "enum": [
              "short",
              "long"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "naturalFrame": {
          "enum": [
            "landscape",
            "portrait",
            "both"
          ]
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "minWorkerVersion",
        "composition"
      ],
      "properties": {
        "engine": {
          "enum": [
            "ffmpeg-stills",
            "remotion-2d",
            "sprite-rig",
            "manim",
            "godot-2d",
            "remotion-3d",
            "godot-3d",
            "blender-cycles",
            "provider-video"
          ]
        },
        "minWorkerVersion": {
          "type": "string",
          "pattern": "^\\d{1,6}(\\.\\d{1,6}){0,3}$"
        },
        "composition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required for remotion-2d; null otherwise."
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pacing",
        "onScreen",
        "captions",
        "audio",
        "assets"
      ],
      "properties": {
        "pacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shotSeconds",
            "hookWithinMs",
            "cutsPerMinute",
            "transitionSec"
          ],
          "properties": {
            "shotSeconds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.5
              },
              "minItems": 2,
              "maxItems": 2
            },
            "hookWithinMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 60000
            },
            "cutsPerMinute": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "transitionSec": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "onScreen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elements",
            "motionTokens",
            "elementAnimation"
          ],
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "enum": [
                  "plate",
                  "heading",
                  "callout",
                  "counter",
                  "bar",
                  "gauge",
                  "arrow",
                  "tally",
                  "particles",
                  "diagram"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "motionTokens": {
              "type": "array",
              "items": {
                "enum": [
                  "draw",
                  "pop",
                  "gauge",
                  "counter",
                  "bar",
                  "arrow",
                  "tally",
                  "particles",
                  "pull",
                  "push",
                  "whip",
                  "shake",
                  "drift",
                  "parallax",
                  "scribble",
                  "blot",
                  "flicker",
                  "morph",
                  "dim"
                ]
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "elementAnimation": {
              "type": "boolean"
            }
          }
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "spec",
            "safeAreaPct"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "spec": {
              "enum": [
                "caption-spec-v1"
              ]
            },
            "safeAreaPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "narrated",
            "targetLufs",
            "maxTruePeakDb",
            "musicPolicy"
          ],
          "properties": {
            "narrated": {
              "type": "boolean"
            },
            "targetLufs": {
              "type": "number",
              "minimum": -40,
              "maximum": -5
            },
            "maxTruePeakDb": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            },
            "musicPolicy": {
              "enum": [
                "none",
                "self-generated",
                "licensed",
                "self-or-licensed"
              ]
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "kinds",
            "allowedSources",
            "forbidKinds"
          ],
          "properties": {
            "model": {
              "enum": [
                "image-per-shot",
                "plates-and-diagrams"
              ]
            },
            "kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "video",
                  "reference-video",
                  "image",
                  "audio",
                  "font",
                  "sprite-sheet",
                  "model-3d",
                  "script",
                  "other"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "allowedSources": {
              "type": "array",
              "items": {
                "enum": [
                  "upload",
                  "hermes",
                  "muse",
                  "worker",
                  "licensed",
                  "generated"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "forbidKinds": {
              "type": "array",
              "items": {
                "enum": [
                  "video",
                  "reference-video",
                  "image",
                  "audio",
                  "font",
                  "sprite-sheet",
                  "model-3d",
                  "script",
                  "other"
                ]
              },
              "minItems": 0,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beatShape",
        "qc",
        "themes",
        "keywords",
        "cautions",
        "sources"
      ],
      "properties": {
        "beatShape": {
          "enum": [
            "ending-cta",
            "ending-outro",
            "single"
          ]
        },
        "qc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minPresentationScore",
            "gates"
          ],
          "properties": {
            "minPresentationScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "gates": {
              "type": "array",
              "items": {
                "enum": [
                  "G-script",
                  "G-storyboard",
                  "G-assets",
                  "G-voice",
                  "G-technical",
                  "G-presentation",
                  "G-compliance",
                  "G-claims"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "expect"
      ],
      "properties": {
        "payload": {
          "const": "fixtures/payload.json"
        },
        "expect": {
          "const": "fixtures/expect.json"
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref",
          "licence",
          "notes"
        ],
        "properties": {
          "type": {
            "enum": [
              "upload",
              "link",
              "repo",
              "skill",
              "article",
              "owner-note"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "curation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "ref",
          "result",
          "notes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "ci-render",
              "trial-run",
              "qc",
              "hermes-review",
              "owner-review"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "approved",
              "rejected",
              "note"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
